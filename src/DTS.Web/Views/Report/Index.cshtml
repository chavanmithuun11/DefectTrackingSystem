@{
    ViewData["Title"] = "Reports";
    var projects = ViewBag.Projects as List<DTS.Domain.Entities.Project> ?? new List<DTS.Domain.Entities.Project>();
}

<div class="page-header">
    <h2><i class="fas fa-chart-bar me-2"></i>Reports</h2>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="icon-circle bg-primary"><i class="fas fa-bug"></i></div>
                <div>
                    <h5 class="mb-0">Defect Summary</h5>
                    <p class="mb-0 text-muted small">Overview of all defects</p>
                </div>
            </div>
            <a href="/Report/DefectSummary" class="btn btn-primary w-100">View Report</a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="icon-circle bg-success"><i class="fas fa-project-diagram"></i></div>
                <div>
                    <h5 class="mb-0">Project-wise</h5>
                    <p class="mb-0 text-muted small">Defects per project</p>
                </div>
            </div>
            <a href="/Report/ProjectWise" class="btn btn-success w-100">View Report</a>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="icon-circle bg-info"><i class="fas fa-users"></i></div>
                <div>
                    <h5 class="mb-0">User Performance</h5>
                    <p class="mb-0 text-muted small">Developer resolution rates</p>
                </div>
            </div>
            <a href="/Report/UserPerformance" class="btn btn-info w-100 text-white">View Report</a>
        </div>
    </div>
</div>

<div class="form-card mb-4">
    <h5 class="mb-3"><i class="fas fa-file-csv me-2"></i>Export Data</h5>
    <div class="d-flex gap-2">
        <a href="/Report/ExportCsv?type=defects" class="btn btn-outline-primary"><i class="fas fa-download me-1"></i>Export Defects (CSV)</a>
        <a href="/Report/ExportCsv?type=projects" class="btn btn-outline-success"><i class="fas fa-download me-1"></i>Export Projects (CSV)</a>
    </div>
</div>
