@model List<DTS.Application.DTOs.ProjectWiseReportDto>

@{
    ViewData["Title"] = "Project-wise Report";
}

<div class="page-header">
    <h2><i class="fas fa-project-diagram me-2"></i>Project-wise Report</h2>
    <a href="/Report" class="btn btn-outline-secondary">Back to Reports</a>
</div>

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Project</th>
                <th>Total Defects</th>
                <th>Open</th>
                <th>Closed</th>
                <th>Critical</th>
                <th>Progress</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.ProjectName</strong></td>
                    <td>@item.TotalDefects</td>
                    <td><span class="badge bg-warning">@item.OpenDefects</span></td>
                    <td><span class="badge bg-success">@item.ClosedDefects</span></td>
                    <td><span class="badge bg-danger">@item.CriticalDefects</span></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:8px;">
                                <div class="progress-bar bg-success" style="width:@item.ProgressPercentage%"></div>
                            </div>
                            <span class="small text-muted">@item.ProgressPercentage%</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
