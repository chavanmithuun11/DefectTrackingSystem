@model IEnumerable<DTS.Application.DTOs.DefectDto>

@{
    ViewData["Title"] = "Defects";
}

<div class="page-header">
    <h2><i class="fas fa-bug me-2"></i>Defects</h2>
    @if (User.IsInRole("Administrator") || User.IsInRole("ProjectManager") || User.IsInRole("Tester"))
    {
        <a href="/Defect/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Defect</a>
    }
</div>

<div class="form-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <select name="projectId" class="form-select">
                <option value="">All Projects</option>
                @foreach (var project in ViewBag.Projects as List<DTS.Domain.Entities.Project> ?? new())
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<DTS.Domain.Enums.DefectStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="severity" class="form-select" asp-items="Html.GetEnumSelectList<DTS.Domain.Enums.DefectSeverity>()">
                <option value="">All Severities</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select" asp-items="Html.GetEnumSelectList<DTS.Domain.Enums.DefectPriority>()">
                <option value="">All Priorities</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="text" name="search" class="form-control" placeholder="Search..." />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter"></i></button>
        </div>
    </form>
</div>

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Project</th>
                <th>Severity</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var defect in Model)
                {
                    <tr>
                        <td><span class="fw-mono text-muted">@defect.DefectId</span></td>
                        <td><a href="/Defect/Details/@defect.Id" class="text-decoration-none fw-medium">@defect.Title</a></td>
                        <td>@defect.ProjectName</td>
                        <td><span class="badge-severity-@defect.SeverityName.ToLower() badge-status">@defect.SeverityName</span></td>
                        <td><span class="badge-status badge-status-@defect.PriorityName.ToLower()">@defect.PriorityName</span></td>
                        <td><span class="badge-status badge-status-@defect.StatusName.ToLower()">@defect.StatusName</span></td>
                        <td>@(defect.AssignedToName ?? "Unassigned")</td>
                        <td>@defect.CreatedAt.ToString("MMM dd")</td>
                        <td>
                            <a href="/Defect/Details/@defect.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center py-5 text-muted">No defects found.</td></tr>
            }
        </tbody>
    </table>
</div>
