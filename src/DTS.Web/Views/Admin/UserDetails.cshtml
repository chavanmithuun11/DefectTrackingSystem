@model DTS.Application.DTOs.UserDto

@{
    ViewData["Title"] = "User Details";
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}

<div class="page-header">
    <h2><i class="fas fa-user me-2"></i>User Details</h2>
    <a href="/Admin/Users" class="btn btn-outline-secondary">Back to Users</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="form-card mb-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="avatar-circle" style="width:64px;height:64px;font-size:28px;">@Model.FullName[0]</div>
                <div>
                    <h4 class="mb-1">@Model.FullName</h4>
                    <p class="mb-0 text-muted">@Model.Email</p>
                </div>
                <div class="ms-auto">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted">Phone</label>
                    <p>@(Model.PhoneNumber ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted">Created</label>
                    <p>@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted">Last Login</label>
                    <p>@(Model.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</p>
                </div>
            </div>
        </div>

        <div class="form-card">
            <h5 class="mb-3"><i class="fas fa-user-tag me-2"></i>Role Assignment</h5>
            <form asp-action="UpdateUserRoles" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.Id" />
                <div class="mb-3">
                    @foreach (var role in allRoles)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="roles" value="@role" @(Model.Roles.Contains(role) ? "checked" : "") />
                            <label class="form-check-label">@role</label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Update Roles</button>
            </form>
        </div>
    </div>
</div>
