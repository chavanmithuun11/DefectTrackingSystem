@model DTS.Application.DTOs.ProjectDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <h2><i class="fas fa-project-diagram me-2"></i>@Model.Name</h2>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Administrator") || User.IsInRole("ProjectManager"))
        {
            <a href="/Project/Edit/@Model.Id" class="btn btn-outline-secondary"><i class="fas fa-edit me-2"></i>Edit</a>
            <a href="/Project/AssignMember/@Model.Id" class="btn btn-primary"><i class="fas fa-user-plus me-2"></i>Assign Member</a>
        }
        <a href="/Project" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="form-card mb-4">
            <h5 class="mb-3">Project Details</h5>
            <div class="row mb-3">
                <div class="col-md-6"><strong>Status:</strong> <span class="badge-status badge-status-@Model.StatusName.ToLower()">@Model.StatusName</span></div>
                <div class="col-md-6"><strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><strong>Start Date:</strong> @Model.StartDate.ToString("MMM dd, yyyy")</div>
                <div class="col-md-6"><strong>End Date:</strong> @(Model.EndDate?.ToString("MMM dd, yyyy") ?? "Not set")</div>
            </div>
            <div class="mb-3">
                <strong>Description:</strong>
                <p class="text-muted mt-1">@(Model.Description ?? "No description provided.")</p>
            </div>
        </div>

        <div class="form-card">
            <h5 class="mb-3">Team Members (@Model.Members.Count)</h5>
            <div class="data-table">
                <table class="table">
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Members.Any())
                        {
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@member.UserName</td>
                                    <td>@member.UserEmail</td>
                                    <td>@member.Role</td>
                                    <td>
                                        @if (User.IsInRole("Administrator") || User.IsInRole("ProjectManager"))
                                        {
                                            <form asp-action="RemoveMember" asp-route-id="@member.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this member?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">No members assigned.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="form-card">
            <h5 class="mb-3">Defect Summary</h5>
            <div class="mb-3 d-flex justify-content-between">
                <span>Total Defects</span>
                <span class="fw-bold">@Model.TotalDefects</span>
            </div>
            <div class="mb-3 d-flex justify-content-between">
                <span>Open Defects</span>
                <span class="fw-bold text-warning">@Model.OpenDefects</span>
            </div>
            <div class="mb-3 d-flex justify-content-between">
                <span>Closed Defects</span>
                <span class="fw-bold text-success">@Model.ClosedDefects</span>
            </div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.TotalDefects > 0 ? (Model.ClosedDefects * 100 / Model.TotalDefects) : 0)%"></div>
            </div>
            <small class="text-muted">@(Model.TotalDefects > 0 ? (Model.ClosedDefects * 100 / Model.TotalDefects) : 0)% resolved</small>
        </div>
    </div>
</div>
