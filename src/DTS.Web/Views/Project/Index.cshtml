@model IEnumerable<DTS.Application.DTOs.ProjectDto>

@{
    ViewData["Title"] = "Projects";
}

<div class="page-header">
    <h2><i class="fas fa-project-diagram me-2"></i>Projects</h2>
    @if (User.IsInRole("Administrator") || User.IsInRole("ProjectManager"))
    {
        <a href="/Project/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Project</a>
    }
</div>

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Project Name</th>
                <th>Status</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Defects</th>
                <th>Open</th>
                <th>Closed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var project in Model)
                {
                    <tr>
                        <td>
                            <a href="/Project/Details/@project.Id" class="text-decoration-none fw-medium">@project.Name</a>
                        </td>
                        <td><span class="badge-status badge-status-@project.StatusName.ToLower()">@project.StatusName</span></td>
                        <td>@project.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@(project.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                        <td>@project.TotalDefects</td>
                        <td>@project.OpenDefects</td>
                        <td>@project.ClosedDefects</td>
                        <td>
                            <a href="/Project/Details/@project.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a>
                            @if (User.IsInRole("Administrator") || User.IsInRole("ProjectManager"))
                            {
                                <a href="/Project/Edit/@project.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@project.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-muted">No projects found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
