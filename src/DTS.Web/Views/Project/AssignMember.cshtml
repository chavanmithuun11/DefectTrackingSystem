@model DTS.Application.DTOs.AssignMemberDto

@{
    ViewData["Title"] = "Assign Member";
    var users = ViewBag.Users as List<dynamic> ?? new List<dynamic>();
}

<div class="page-header">
    <h2><i class="fas fa-user-plus me-2"></i>Assign Member</h2>
    <a href="/Project/Details/@ViewBag.ProjectId" class="btn btn-outline-secondary">Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <h5 class="mb-3">@ViewBag.ProjectName</h5>
            <form asp-action="AssignMember" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProjectId" value="@ViewBag.ProjectId" />
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label">Select User</label>
                    <select asp-for="UserId" class="form-select" required>
                        <option value="">Select a user</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.FullName (@user.Email)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Role in Project</label>
                    <input asp-for="Role" class="form-control" placeholder="e.g. Developer, Tester, Manager" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Assign Member</button>
                    <a href="/Project/Details/@ViewBag.ProjectId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
