@model DTS.Application.DTOs.UserDto

@{
    ViewData["Title"] = "Profile";
}

<div class="page-header">
    <h2><i class="fas fa-user me-2"></i>My Profile</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-card">
            <div class="text-center mb-4">
                <div class="avatar-circle mx-auto" style="width:80px;height:80px;font-size:32px;">@Model.FullName[0]</div>
                <h4 class="mt-3 mb-1">@Model.FullName</h4>
                <p class="text-muted mb-0">@Model.Email</p>
                <div class="mt-2">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-primary me-1">@role</span>
                    }
                </div>
            </div>

            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@Model.Email" disabled />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Member Since</label>
                        <input type="text" class="form-control" value="@Model.CreatedAt.ToString("MMM dd, yyyy")" disabled />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Last Login</label>
                        <input type="text" class="form-control" value="@(Model.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input type="text" class="form-control" value="@(Model.IsActive ? "Active" : "Inactive")" disabled />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Update Profile</button>
                <a href="/Account/ChangePassword" class="btn btn-outline-secondary ms-2">Change Password</a>
            </form>
        </div>
    </div>
</div>
