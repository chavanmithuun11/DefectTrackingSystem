@{
    Layout = "_Layout";
    ViewData["Title"] = "Password Reset Successful";
}

<div class="auth-card text-center">
    <div class="brand">
        <i class="fas fa-bug"></i>
        <h2>Defect Tracking System</h2>
    </div>
    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
    <h4>Password reset successful</h4>
    <p class="text-muted">Your password has been reset. You can now log in with your new password.</p>
    <a href="/Account/Login" class="btn btn-primary mt-3">Go to Login</a>
</div>
