@model DTS.Application.DTOs.ForgotPasswordDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="brand">
        <i class="fas fa-bug"></i>
        <h2>Defect Tracking System</h2>
        <p class="text-muted">Reset your password</p>
    </div>
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">Send Reset Link</button>
        <div class="text-center mt-3">
            <a href="/Account/Login" class="text-decoration-none">Back to Login</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
